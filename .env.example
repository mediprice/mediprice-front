# PORT=3000

# 백엔드 주소. BFF 중계, 로그인 시작, 타입 생성(pnpm api:generate)에 쓴다.
NEXT_PUBLIC_API_URL=http://localhost:8080

# 이 사이트의 공개 주소(origin). canonical·Open Graph·sitemap·robots의 절대 주소에 쓴다.
# 운영 빌드(NODE_ENV=production, 로컬 `pnpm build` 포함)에서는 필수다. Vercel 미리보기는 비워 두면 브랜치 주소(VERCEL_BRANCH_URL)를 쓴다. 개발에서는 비워 두면 http://localhost:3000이다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 백엔드 BFF_SHARED_SECRET과 같은 값. 설정하면 BFF가 사용자 IP를 백엔드에 전달한다(AI 비회원 한도). 16자 이상.
# 운영 배포(VERCEL_ENV=production)에서는 필수이고, 로컬·미리보기에서는 선택이다. 실제 값은 커밋하지 않는다.
# BFF_SHARED_SECRET=

# (선택) 네이버 지도 Client ID(NCP 콘솔 Maps 애플리케이션의 Client ID, Dynamic Map 사용). 없으면 지도 탐색(/map)이 목록만 보여 준다.
# NCP 콘솔의 Web 서비스 URL에 http://localhost:3000 과 배포 도메인(미리보기 포함)을 등록해야 인증된다.
# NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
