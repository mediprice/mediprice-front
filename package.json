{
  "name": "mediprice-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "dotenv -c -- next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "dotenv -c -- next start",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-devtools": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
